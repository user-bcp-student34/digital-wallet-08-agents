# Variables de entorno — Wallet Onboarding (MVP básico funcional)
# Copiar como ".env" y ajustar según el entorno. Ninguna de estas variables
# contiene secretos; el mock externo no requiere credenciales.

# --- Backend (src/main.py) ---

# Base URL del mock externo de KYC & Wallet (ver client/openapi/kyc-wallet-mock.yaml).
# Incluye el prefijo de grupo asignado para el taller.
KYC_WALLET_MOCK_BASE_URL=https://bcp-wallet-mock.yefri.workers.dev/groups/8

# Límites de operación de ACTIVE_BASIC, en céntimos de PEN (parametrizables).
ACTIVE_BASIC_PER_OPERATION_CENTS=2000
ACTIVE_BASIC_DAILY_TOTAL_CENTS=6000

# development | test habilitan el gancho de prueba `testScenario` en /registrations.
# En production, cualquier solicitud con testScenario es rechazada (400 TEST_SCENARIO_NOT_ALLOWED).
APP_ENV=development

# --- Frontend (src/frontend_mock.py) ---

# URL donde corre el backend FastAPI.
WALLET_API_BASE_URL=http://127.0.0.1:8000

# --- Pruebas Selenium (tests/selenium/test_onboarding_ui.py) ---

# URL donde corre el frontend Streamlit.
FRONTEND_URL=http://localhost:8501
